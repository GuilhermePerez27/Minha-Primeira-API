{
  "info": {
    "name": "API Filmes PRO",
    "_postman_id": "99999999-aaaa-bbbb-cccc-123456789000",
    "description": "Coleção automatizada com testes e fluxo completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "usuario_id", "value": "" },
    { "key": "filme_id", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"teste@email.com\"\n}"
        },
        "url": "{{base_url}}/login"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Login OK\", () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"token\", json.token);",
              "postman.setNextRequest(\"2 - Criar Usuário\");"
            ]
          }
        }
      ]
    },
    {
      "name": "2 - Criar Usuário",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Guilherme\",\n  \"email\": \"gui@email.com\"\n}"
        },
        "url": "{{base_url}}/api/usuarios"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Usuário criado\", () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"usuario_id\", json.id);",
              "postman.setNextRequest(\"3 - Criar Filme\");"
            ]
          }
        }
      ]
    },
    {
      "name": "3 - Criar Filme",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Vingadores\",\n  \"arrecadacao\": 2.8,\n  \"categoria\": \"12 anos\",\n  \"duracao\": 180,\n  \"usuario_id\": {{usuario_id}}\n}"
        },
        "url": "{{base_url}}/api/filmes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Filme criado\", () => pm.response.to.have.status(201));",
              "const json = pm.response.json();",
              "pm.collectionVariables.set(\"filme_id\", json.id);",
              "postman.setNextRequest(\"4 - Listar Filmes\");"
            ]
          }
        }
      ]
    },
    {
      "name": "4 - Listar Filmes",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/filmes"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Listagem OK\", () => pm.response.to.have.status(200));",
              "postman.setNextRequest(\"5 - Buscar Filme por ID\");"
            ]
          }
        }
      ]
    },
    {
      "name": "5 - Buscar Filme por ID",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/api/filmes/{{filme_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Filme encontrado\", () => pm.response.to.have.status(200));",
              "postman.setNextRequest(\"6 - Atualizar Filme\");"
            ]
          }
        }
      ]
    },
    {
      "name": "6 - Atualizar Filme",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Vingadores Atualizado\",\n  \"arrecadacao\": 3.0,\n  \"categoria\": \"12 anos\",\n  \"duracao\": 190\n}"
        },
        "url": "{{base_url}}/api/filmes/{{filme_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Filme atualizado\", () => pm.response.to.have.status(200));",
              "postman.setNextRequest(\"7 - Deletar Filme\");"
            ]
          }
        }
      ]
    },
    {
      "name": "7 - Deletar Filme",
      "request": {
        "method": "DELETE",
        "url": "{{base_url}}/api/filmes/{{filme_id}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Filme deletado\", () => pm.response.to.have.status(200));",
              "postman.setNextRequest(null);"
            ]
          }
        }
      ]
    }
  ]
}